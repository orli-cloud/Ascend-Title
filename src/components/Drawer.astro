---
// Side drawer used on every page for primary contact info.
---
<aside class="drawer" id="drawer" aria-hidden="true" aria-label="Contact">
  <button class="drawer-backdrop" data-drawer-close aria-label="Close menu"></button>
  <div class="drawer-panel">
    <div class="drawer-watermark" aria-hidden="true"></div>

    <div class="drawer-top">
      <button class="drawer-close" data-drawer-close aria-label="Close menu">
        <span class="close-x" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>

    <div class="drawer-body">
      <h2 class="drawer-title">Let's close<br><em>your next<br>deal.</em></h2>

      <ul class="drawer-contacts">
        <li>
          <a href="tel:2016015700" class="drawer-value"><span class="drawer-link-text">201.601.5700</span></a>
        </li>
        <li>
          <a href="mailto:orders@ascendtitle.com" class="drawer-value"><span class="drawer-link-text">orders@ascendtitle.com</span></a>
        </li>
        <li>
          <span class="drawer-value drawer-value-static">
            440 Sylvan Avenue, Suite 240<br>Englewood Cliffs, NJ 07632
          </span>
        </li>
        <li>
          <span class="drawer-value drawer-value-static">
            1600 Ave of the States, Suite 212<br>Lakewood, NJ 08701
          </span>
        </li>
      </ul>
    </div>
  </div>
</aside>
