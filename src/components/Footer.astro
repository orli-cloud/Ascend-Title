---
// Footer with quick links + giant ASCEND brand mark.
---
<footer class="footer" id="footer">
  <div class="footer-content container">
    <div class="footer-main">
      <div class="footer-col footer-col--intro">
        <h2 class="footer-heading">We close<br>nationally.</h2>
        <a href="/#contact" class="footer-brief">
          <span>Start a project</span>
          <svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg>
        </a>
        <a href="mailto:orders@ascendtitle.com" class="footer-email">orders@ascendtitle.com</a>
      </div>
      <div class="footer-col">
        <h5 class="footer-label">Quick Links</h5>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/#resources">Resources</a>
        <a href="/#contact">Contact</a>
      </div>
      <div class="footer-col">
        <h5 class="footer-label">Services</h5>
        <a href="#">Commercial</a>
        <a href="#">Residential</a>
        <a href="#">National</a>
        <a href="#">Full Escrow</a>
      </div>
      <div class="footer-col">
        <h5 class="footer-label">Socials</h5>
        <a href="#">Instagram</a>
        <a href="#">LinkedIn</a>
        <a href="#">Facebook</a>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <span>&copy; 2026 Ascend Title</span>
      <a href="https://gcnymarketing.com/" target="_blank" rel="noopener" class="footer-logo-link" aria-label="GCNY Marketing">
        <img src="/Elements/gcny logo icon.png" alt="GCNY Marketing" class="footer-logo" />
      </a>
    </div>
  </div>

  <div class="footer-brand" aria-hidden="true">
    <span class="footer-brand-word">ASCEND</span>
  </div>
</footer>
