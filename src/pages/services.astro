---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Services — Ascend Title"
  bodyClass="page-about page-services"
>

  <header class="hero hero-about" id="home">
    <nav class="nav" aria-label="Main">
      <div class="nav-inner">
        <a href="/" class="logo" aria-label="Ascend Title home">
          <img src="/Logo/Logo white.png" alt="Ascend Title" class="logo-img" />
        </a>
        <ul class="nav-links">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/about" class="nav-link">About</a></li>
          <li><a href="/services" class="nav-link active">Services</a></li>
          <li><a href="/portfolio" class="nav-link">Portfolio</a></li>
          <li><a href="/resources" class="nav-link">Resources</a></li>
          <li><a href="https://ascendra.qualia.io/" class="nav-link" target="_blank" rel="noopener">Login</a></li>
          <li><a href="/contact" class="nav-link">Contact</a></li>
        </ul>
        <button class="menu-btn" aria-label="Open contact menu" aria-expanded="false" aria-controls="drawer">
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </nav>

    <div class="hero-about-stage">
      <div class="hero-navy" aria-hidden="true"></div>
      <div class="hero-image" aria-hidden="true"></div>
      <div class="hero-shape-echo" style="--echo-x: 7vw;  --echo-alpha: 0.06; --echo-delay: 0.30s;" aria-hidden="true"></div>
      <div class="hero-shape-echo" style="--echo-x: 14vw; --echo-alpha: 0.11; --echo-delay: 0.45s;" aria-hidden="true"></div>
      <div class="hero-shape-echo" style="--echo-x: 21vw; --echo-alpha: 0.18; --echo-delay: 0.60s;" aria-hidden="true"></div>

      <div class="hero-about-content">
        <span class="eyebrow eyebrow-light"><span class="eyebrow-dash"></span>Our Services</span>
        <h1 class="hero-title hero-about-title hero-services-title">Expert-Led<br>Title Solutions</h1>
        <div class="hero-about-story hero-services-story">
          <p class="story-body">
            Real estate transactions move quickly. Delays create stress. Mistakes are expensive. <em>We take responsibility for your deal from start to finish.</em>
          </p>
        </div>
      </div>
    </div>
  </header>

  <div class="svc-cursor" aria-hidden="true">
    <svg class="svc-cursor-arrow" viewBox="0 0 12 6"><polyline points="1,5 6,1 11,5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    <span class="svc-cursor-label">Scroll</span>
    <svg class="svc-cursor-arrow" viewBox="0 0 12 6"><polyline points="1,1 6,5 11,1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
  </div>

  <section class="svc-stack" id="services-stack">
    <div class="svc-stage" aria-label="Services">

      <div class="svc-bg-stack" aria-hidden="true">
        <div class="svc-bg svc-bg--paper"      data-bg="0"></div>
        <div class="svc-bg svc-bg--paper-warm" data-bg="1"></div>
        <div class="svc-bg svc-bg--blue-mid"   data-bg="2"></div>
        <div class="svc-bg svc-bg--paper-gray" data-bg="3"></div>
        <div class="svc-bg svc-bg--blue-soft"  data-bg="4"></div>
        <div class="svc-bg svc-bg--navy"       data-bg="5"></div>
      </div>

      <div class="svc-shape-stage" aria-hidden="true">
        <div class="svc-shape">
          <div class="svc-shape-face svc-shape-face--front"></div>
          <div class="svc-shape-face svc-shape-face--back"></div>
          <div class="svc-shape-face svc-shape-face--right"></div>
          <div class="svc-shape-face svc-shape-face--left"></div>
          <div class="svc-shape-face svc-shape-face--top"></div>
          <div class="svc-shape-face svc-shape-face--bottom"></div>
        </div>
      </div>

      <ol class="svc-dots" aria-label="Service progress">
        <li><a class="svc-dot is-active" href="#commercial"   data-dot="0" aria-label="Commercial Services"></a></li>
        <li><a class="svc-dot"            href="#residential"  data-dot="1" aria-label="Residential Services"></a></li>
        <li><a class="svc-dot"            href="#national"     data-dot="2" aria-label="National Services"></a></li>
        <li><a class="svc-dot"            href="#closing"      data-dot="3" aria-label="Closing Services"></a></li>
        <li><a class="svc-dot"            href="#escrow"       data-dot="4" aria-label="Full Escrow Services"></a></li>
        <li><a class="svc-dot"            href="#transaction"  data-dot="5" aria-label="Complete Transaction Management"></a></li>
      </ol>

      <div class="svc-text-stack">
        <article class="svc-text is-active" data-text="0" data-tone="ink" id="commercial">
          <div class="container svc-text-inner">
            <h2 class="svc-text-title"><span class="svc-text-line"><span>Commercial Services</span></span></h2>
            <p class="svc-text-lead">Our team brings unmatched expertise in commercial real estate, combining deep knowledge of property law with years of experience navigating complex, high-stakes transactions.</p>
            <p class="svc-text-body">We manage every aspect to ensure deals progress smoothly and close without complications, giving clients confidence and clarity throughout the process.</p>
          </div>
        </article>

        <article class="svc-text" data-text="1" data-tone="ink" id="residential">
          <div class="container svc-text-inner">
            <h2 class="svc-text-title"><span class="svc-text-line"><span>Residential Services</span></span></h2>
            <p class="svc-text-lead">From first-time homebuyers to seasoned investors, we guide every residential transaction with expert oversight and personalized attention.</p>
            <p class="svc-text-body">Our team handles every detail, ensuring each closing is executed efficiently, accurately, and with complete transparency, so clients can focus on their new home or investment with peace of mind.</p>
          </div>
        </article>

        <article class="svc-text" data-text="2" data-tone="light" id="national">
          <div class="container svc-text-inner">
            <h2 class="svc-text-title"><span class="svc-text-line"><span>National Services</span></span></h2>
            <p class="svc-text-lead">Across all 50 states, our team leverages deep knowledge of local laws and regulations, adapting seamlessly to each jurisdiction.</p>
            <p class="svc-text-body">With years of experience handling complex transactions nationwide, we manage every detail, ensuring smooth, reliable closings nationwide.</p>
          </div>
        </article>

        <article class="svc-text" data-text="3" data-tone="ink" id="closing">
          <div class="container svc-text-inner">
            <h2 class="svc-text-title"><span class="svc-text-line"><span>Closing Services</span></span></h2>
            <p class="svc-text-lead">Our experienced team prepares every document required for a smooth and stress-free closing.</p>
            <p class="svc-text-body">From Buyer and Seller Affidavits to Heirship Affidavits, Deeds, Mortgages, and Discharge of Mortgages, we handle all necessary paperwork to ensure your transaction reaches the closing table efficiently and flawlessly.</p>
          </div>
        </article>

        <article class="svc-text" data-text="4" data-tone="light" id="escrow">
          <div class="container svc-text-inner">
            <h2 class="svc-text-title"><span class="svc-text-line"><span>Full Escrow Services</span></span></h2>
            <p class="svc-text-lead">We provide comprehensive escrow management, acting as a neutral third party to securely manage documents and hold funds in trust according to the direction of all parties involved.</p>
            <p class="svc-text-body">Ascend Title prepares detailed closing statements and ensures accurate fund distribution in strict accordance with Lender, Purchaser, and Seller instructions.</p>
          </div>
        </article>

        <article class="svc-text" data-text="5" data-tone="light" id="transaction">
          <div class="container svc-text-inner">
            <h2 class="svc-text-title"><span class="svc-text-line"><span>Complete Transaction Management</span></span></h2>
            <p class="svc-text-lead">From meticulous title searches to surveys, reports, settlements, and recordings, our team oversees every aspect of the title process.</p>
            <p class="svc-text-body">By coordinating each step with precision and expertise, we deliver seamless closings while keeping the entire transaction organized and on track.</p>
          </div>
        </article>
      </div>
    </div>

    <div class="svc-track" data-track="0" aria-hidden="true"></div>
    <div class="svc-track" data-track="1" aria-hidden="true"></div>
    <div class="svc-track" data-track="2" aria-hidden="true"></div>
    <div class="svc-track" data-track="3" aria-hidden="true"></div>
    <div class="svc-track" data-track="4" aria-hidden="true"></div>
    <div class="svc-track" data-track="5" aria-hidden="true"></div>
  </section>

  <section class="cta" id="contact">
    <div class="cta-pin">
      <div class="cta-sticky">
        <div class="cta-base" aria-hidden="true"></div>
        <div class="cta-intro cta-intro--under"><span>Let's<br>Build</span></div>
        <div class="cta-reveal" aria-hidden="true">
          <div class="cta-bg">
            <div class="bg-image"></div>
            <div class="bg-overlay"></div>
            <div class="bg-shimmer"></div>
          </div>
        </div>
        <div class="cta-intro cta-intro--over" aria-hidden="true"><span>Let's<br>Build</span></div>
        <div class="cta-final">
          <div class="container">
            <h2 class="cta-title">
              Bring your deal to the closing table with confidence and ease.
            </h2>
            <p class="cta-sub">
              If your transactions require precision and proactive leadership, Ascend Title was built for you. Let's get your next deal moving with a team that leads from day one.
            </p>
            <a href="/contact" class="btn btn-ghost" data-magnetic>
              <span class="btn-arrow btn-arrow-left"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
              <span class="btn-label">Get Started</span>
              <span class="btn-arrow btn-arrow-right"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
