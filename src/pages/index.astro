---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Ascend Title — A Higher Standard of Closing"
  scrollCursor={true}
>

  <header class="hero hero-reverse" id="home">
    <nav class="nav" aria-label="Main">
      <div class="nav-inner">
        <a href="/#home" class="logo" aria-label="Ascend Title home">
          <img src="/Logo/Logo white.png" alt="Ascend Title" class="logo-img" />
        </a>
        <ul class="nav-links">
          <li><a href="/#home" class="nav-link active">Home</a></li>
          <li><a href="/about" class="nav-link">About</a></li>
          <li><a href="/services" class="nav-link">Services</a></li>
          <li><a href="/#resources" class="nav-link">Resources</a></li>
          <li><a href="/#login" class="nav-link">Login</a></li>
          <li><a href="/#contact" class="nav-link">Contact</a></li>
        </ul>
        <button class="menu-btn" aria-label="Open contact menu" aria-expanded="false" aria-controls="drawer">
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </nav>

    <div class="hero-sticky">
      <div class="hero-navy" aria-hidden="true"></div>
      <div class="hero-image" aria-hidden="true"></div>

      <div class="hero-content">
        <h1 class="hero-title">A Higher<br>Standard<br>of Closing</h1>
        <div class="hero-side">
          <p class="hero-sub">Unrivaled expertise in commercial and residential title insurance.</p>
          <a href="/#about" class="btn btn-ghost">
            <span class="btn-arrow btn-arrow-left"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
            <span class="btn-label">Get Started</span>
            <span class="btn-arrow btn-arrow-right"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="about" id="about">
    <div class="container">
      <h2 class="about-title" data-split-fill>Ascend Title is a national title and escrow firm built on four decades of experience. We navigate complex commercial and residential transactions across all 50 states.</h2>
    </div>
  </section>

  <section class="services-stack" id="services">
    <div class="container">
      <div class="stack-list">
        <a class="stack-card" href="#" style="--i:0">
          <div class="stack-body">
            <h3 class="stack-card-title">Commercial Services</h3>
            <p class="stack-card-desc">Our team brings unmatched experience in commercial real estate, navigating the complexities of property law and intricate transactions to ensure every deal closes without complications.</p>
          </div>
          <span class="stack-arrow"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
        </a>

        <a class="stack-card" href="#" style="--i:1">
          <div class="stack-body">
            <h3 class="stack-card-title">Residential Services</h3>
            <p class="stack-card-desc">From first homes to seasoned investments, we guide every residential transaction with expert clarity, deep knowledge, and a focus on protecting your interests at every turn.</p>
          </div>
          <span class="stack-arrow"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
        </a>

        <a class="stack-card" href="#" style="--i:2">
          <div class="stack-body">
            <h3 class="stack-card-title">National Services</h3>
            <p class="stack-card-desc">Our team leverages deep knowledge of local laws and regulations across all 50 states, adapting seamlessly to each jurisdiction. With years of experience handling transactions nationwide, we manage every detail, ensuring smooth, reliable closings across the country.</p>
          </div>
          <span class="stack-arrow"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
        </a>

        <a class="stack-card" href="#" style="--i:3">
          <div class="stack-body">
            <h3 class="stack-card-title">Closing Services</h3>
            <p class="stack-card-desc">Our team prepares the closing documents required for a smooth closing, handling all essential paperwork to ensure your transaction reaches the closing table efficiently and without delays.</p>
          </div>
          <span class="stack-arrow"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
        </a>

        <a class="stack-card" href="#" style="--i:4">
          <div class="stack-body">
            <h3 class="stack-card-title">Full Escrow Services</h3>
            <p class="stack-card-desc">Acting as a trusted neutral third party, we securely manage documents and funds, preparing closing statements and distributing proceeds precisely according to lender, purchaser, and seller instructions.</p>
          </div>
          <span class="stack-arrow"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
        </a>

        <a class="stack-card" href="#" style="--i:5">
          <div class="stack-body">
            <h3 class="stack-card-title">Complete Transaction Management</h3>
            <p class="stack-card-desc">From title searches and surveys to settlements and recordings, we coordinate every step of the title process with precision, keeping your transaction organized, efficient, and moving steadily toward closing.</p>
          </div>
          <span class="stack-arrow"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <section class="excellence">
    <div class="ex-pin">
      <div class="ex-sticky">
        <div class="container">
          <div class="excellence-head">
            <span class="eyebrow reveal"><span class="eyebrow-dash"></span>Excellence in Service</span>
            <h2 class="excellence-title" data-split-fill>
              Every experience is defined by our relentless commitment to exceptional client care.
            </h2>
          </div>
          <div class="ex-accordion">
            <div class="ex-panel ex-panel--light is-active" data-panel="0">
              <div class="ex-panel-inner">
                <span class="ex-slashes" aria-hidden="true"><span></span></span>
                <h3 class="ex-title">Superior Service</h3>
                <p class="ex-desc">All aspects of your transaction are expertly managed from start to finish. If you value clear communication, smooth closings, and a team that takes ownership, you're in the right place.</p>
              </div>
            </div>
            <div class="ex-panel ex-panel--mid" data-panel="1">
              <div class="ex-panel-inner">
                <span class="ex-slashes" aria-hidden="true"><span></span><span></span></span>
                <h3 class="ex-title">No Handoffs</h3>
                <p class="ex-desc">Every account is assigned direct access to experienced professionals who are responsible for your file. Always accessible, they provide the personalized experience our clients rely on.</p>
              </div>
            </div>
            <div class="ex-panel ex-panel--dark" data-panel="2">
              <div class="ex-panel-inner">
                <span class="ex-slashes" aria-hidden="true"><span></span><span></span><span></span></span>
                <h3 class="ex-title">Closing Commitment</h3>
                <p class="ex-desc">From straightforward residential deals to detailed commercial closings, we operate with one clear standard: Get it done right. Get it closed smoothly.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="team">
    <div class="container">
      <div class="team-header">
        <div class="team-header-row">
          <span class="eyebrow reveal"><span class="eyebrow-dash"></span>Team</span>
          <a href="#" class="btn btn-outline btn-dark reveal team-cta" data-magnetic>
            <span class="btn-arrow btn-arrow-left"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
            <span class="btn-label">Learn More</span>
            <span class="btn-arrow btn-arrow-right"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
          </a>
        </div>
        <h2 class="team-title reveal">
          Our team combines unmatched mastery and experience, bringing together leaders from every discipline to deliver a powerhouse of talent and results.
        </h2>
      </div>
      <div class="team-grid">
        <div class="team-left">
          <ul class="team-stats">
            <li class="reveal" data-team-idx="0"><span class="stat-label">40+ Years Experience</span></li>
            <li class="reveal" data-team-idx="1"><span class="stat-label">Proven Track Record Nationwide</span></li>
            <li class="reveal" data-team-idx="2"><span class="stat-label">Experts in Complex Transactions</span></li>
            <li class="reveal" data-team-idx="3"><span class="stat-label">Supporting Clients in All 50 States</span></li>
          </ul>
        </div>

        <div class="team-right">
          <div class="team-image reveal reveal-no-shift">
            <div class="team-image-bg"></div>
            <div class="team-image-slant" aria-hidden="true"></div>
            <div class="team-image-cutout"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="underwriters">
    <div class="uw-marquee" aria-hidden="true">
      <div class="marquee-track">
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
        <img src="/Logo/Logo.png" alt="Ascend" class="uw-logo" />
        <span class="uw-slash"></span>
      </div>
    </div>
  </section>

  <section class="serve">
    <div class="container">
      <div class="serve-grid">
        <div class="serve-left">
          <span class="eyebrow reveal"><span class="eyebrow-dash"></span>Who We Serve</span>
          <h2 class="serve-title reveal">Built for the professionals behind every serious deal.</h2>
          <a href="/#contact" class="btn btn-ghost reveal serve-cta" data-magnetic>
            <span class="btn-arrow btn-arrow-left"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
            <span class="btn-label">Get In Touch</span>
            <span class="btn-arrow btn-arrow-right"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
          </a>
        </div>
        <ul class="serve-list">
          <li class="reveal serve-from-right" data-stagger="0"><svg class="serve-icon" aria-hidden="true"><use href="#ic-developers"/></svg><span class="serve-text">Commercial Developers</span></li>
          <li class="reveal serve-from-right" data-stagger="1"><svg class="serve-icon" aria-hidden="true"><use href="#ic-investors"/></svg><span class="serve-text">Real Estate Investors</span></li>
          <li class="reveal serve-from-right" data-stagger="2"><svg class="serve-icon" aria-hidden="true"><use href="#ic-brokers"/></svg><span class="serve-text">Brokers and Agents</span></li>
          <li class="reveal serve-from-right" data-stagger="3"><svg class="serve-icon" aria-hidden="true"><use href="#ic-lenders"/></svg><span class="serve-text">Lenders</span></li>
          <li class="reveal serve-from-right" data-stagger="4"><svg class="serve-icon" aria-hidden="true"><use href="#ic-attorneys"/></svg><span class="serve-text">Attorneys</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta angle-top" id="contact">
    <div class="cta-pin">
      <div class="cta-sticky">
        <div class="cta-base" aria-hidden="true"></div>
        <div class="cta-intro cta-intro--under"><span>Let's<br>Build</span></div>
        <div class="cta-reveal" aria-hidden="true">
          <div class="cta-bg">
            <div class="bg-image"></div>
            <div class="bg-overlay"></div>
            <div class="bg-shimmer"></div>
          </div>
        </div>
        <div class="cta-intro cta-intro--over" aria-hidden="true"><span>Let's<br>Build</span></div>
        <div class="cta-final">
          <div class="container">
            <h2 class="cta-title">
              Bring your deal to the closing table with confidence and ease.
            </h2>
            <p class="cta-sub">
              If your transactions require precision and proactive leadership, Ascend Title was built for you. Let's get your next deal moving with a team that leads from day one.
            </p>
            <a href="#" class="btn btn-ghost" data-magnetic>
              <span class="btn-arrow btn-arrow-left"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
              <span class="btn-label">Get Started</span>
              <span class="btn-arrow btn-arrow-right"><svg class="arrow-ic" aria-hidden="true"><use href="#arrow"/></svg></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
